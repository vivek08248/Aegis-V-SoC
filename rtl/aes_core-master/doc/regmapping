11. SUMMARY
-----------

CTRL_STATUS[31:16] = STATUS
CTRL_STATUS[15:0]  = CONTROL

STATUS:
    Bit 16 = DONE
    Bit 17 = KDONE
    Bits 31:18 = RESERVED

CONTROL:
    Bit 0 = LD
    Bit 1 = KLD
    Bit 2 = RST
    Bits 15:3 = RESERVED

KEY:
    {KEY0, KEY1, KEY2, KEY3} = KEY[127:0]

TEXT:
    {TEXT0, TEXT1, TEXT2, TEXT3} = TEXT_IN[127:0]

OUTPUT:
    {OUT0, OUT1, OUT2, OUT3} = TEXT_OUT[127:0]

